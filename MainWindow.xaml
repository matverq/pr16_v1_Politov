<Window x:Class="pr16_v1_Politov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr16_v1_Politov"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="0,10,0,0">
            <Label Content="Список имен (ListBox)" HorizontalAlignment="Center" FontSize="16"/>
            <TextBox x:Name="txtForList" FontSize="18" Margin="10,2"/>
            <Button Content="Добавить в ListBox" Click="addlst_Click" HorizontalAlignment="Center" Background="LightGreen" Margin="5"/>

            <ListBox x:Name="lst_add" Height="60" Margin="10,5"/>
            <Button Content="Очистить ListBox" Click="Delete_lst" Background="Red" HorizontalAlignment="Center" Margin="5"/>

            <Separator Margin="0,10"/>
            <Label Content="Данные для таблицы" HorizontalAlignment="Center" FontSize="16"/>

            <Label Content="Фамилия:"/>
            <TextBox x:Name="txtInput" FontSize="18" Margin="10,2"/>

            <Label Content="Группа:"/>
            <TextBox x:Name="txtGroupInput" FontSize="18" Margin="10,2"/>

            <Button x:Name="add" Content="Добавить в таблицу" Click="add_Click" HorizontalAlignment="Center" Background="Green" Margin="10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Label Content="Поиск: "/>
                <TextBox x:Name="txtSearch" Width="150" TextChanged="txtSearch_TextChang"/>
                <ComboBox x:Name="cSort" Margin="10,0" SelectionChanged="cSort_Select">
                    <ComboBoxItem Content="нет" IsSelected="True"/>
                    <ComboBoxItem Content="По фамилии"/>
                    <ComboBoxItem Content="По группе"/>
                </ComboBox>
            </StackPanel>

            <DataGrid x:Name="dgStudents" Height="150" Margin="10" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Фамилия" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Удалить выбранного студента" Background="Orange" Margin="10" Click="Delete_Selected"/>
        </StackPanel>
    </Grid>
</Window>
